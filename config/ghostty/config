# Ghostty configuration. Symlinked to ~/.config/ghostty/config.
# Full reference: `ghostty +show-config --default --docs`

# --- font ----------------------------------------------------------------
# Installed by the playbook as the font-jetbrains-mono-nerd-font cask. The Nerd
# Font variant carries the powerline/devicon glyphs oh-my-zsh themes use.
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# --- theme ---------------------------------------------------------------
# Follows the macOS appearance setting.
theme = light:GruvboxLight,dark:GruvboxDarkHard
background-opacity = 0.97
background-blur-radius = 20

# --- window --------------------------------------------------------------
window-padding-x = 10
window-padding-y = 8
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true

# --- shell ---------------------------------------------------------------
# Ghostty's shell integration adds cursor shape, working-directory reporting
# (so new tabs open where you were) and jump-to-prompt.
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- scrollback ----------------------------------------------------------
scrollback-limit = 100000
copy-on-select = clipboard

# --- keybindings ---------------------------------------------------------
# Splits, matching the muscle memory from iTerm2.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+enter=toggle_split_zoom
keybind = cmd+k=clear_screen
